ALLOWED_APP_ORIGINS=https://deluxetunesapp.pages.dev
DATABASE_URL=
VITE_WINDOWS_DOWNLOAD_URL=https://github.com/remixhubbb-ux/deluxe-tunes/releases/download/v8.1.0/Deluxe-Tunes-Setup.exe

# Local development values
PORT=8787
APP_ORIGIN=http://localhost:5173
OAUTH_BASE_URL=http://localhost:8787
VITE_APP_ORIGIN=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8787
VITE_FRIENDS_API_BASE_URL=http://localhost:8787
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
PASSWORD_RESET_FROM=
PASSWORD_RESET_BASE_URL=http://localhost:5173
# Comma-separated server-account emails allowed to use the private account-record lookup.
# Backend only; never use a VITE_ prefix or add actual admin emails to source control.
ACCOUNT_RECORD_ADMIN_EMAILS=
# Eight-digit second factor for the admin panel. Configure privately in the backend environment.
ADMIN_PANEL_ACCESS_CODE=

# Production backend values (Render)
# NODE_ENV=production
# APP_ORIGIN=https://deluxetunesapp.pages.dev
# OAUTH_BASE_URL=https://deluxe-tunes-api.onrender.com
# ALLOWED_APP_ORIGINS=https://deluxetunesapp.pages.dev
# DATABASE_URL=<Render PostgreSQL Internal Database URL>

# Production frontend values are also committed in .env.production so Vite
# builds the Pages bundle with the Render API URL. Set these in Cloudflare Pages
# too if you manage the URL through the deployment environment instead.
# VITE_API_BASE_URL=https://deluxe-tunes-api.onrender.com
# VITE_FRIENDS_API_BASE_URL=https://deluxe-tunes-api.onrender.com

DISCORD_CLIENT_ID=1550514971572445324
# Optional for confidential Discord OAuth clients. Leave blank when using Public Client + PKCE.
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.deluxetunes.app/api/discord/callback
DISCORD_NEW_RELEASE_WEBHOOK_URL=
SPOTIFY_CLIENT_ID=713afe6b17644c2096acc5a226597345
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=https://api.deluxetunes.app/api/spotify/callback
