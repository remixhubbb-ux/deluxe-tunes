{
  "name": "deluxe-tunes",
  "private": true,
  "version": "8.1.9",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "cap:sync": "npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "android:build": "npm run build && npx cap sync android",
    "android:apk": "npm run android:build && cd android && gradlew.bat assembleDebug",
    "android:aab": "npm run android:build && cd android && gradlew.bat bundleRelease",
    "ios:build": "npm run build && npx cap sync ios",
    "desktop:build": "vite build",
    "desktop:dist": "npm run desktop:build && electron-builder --win --publish never",
    "server": "node server.mjs",
    "start": "node server.mjs",
    "test:discord-release-webhook": "node server.mjs --test-discord-release-webhook",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "bcryptjs": "^3.0.3",
    "discord-rpc": "^4.0.1",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.2.1",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^5.4.10"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "electron": "^38.0.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3"
  },
  "description": "Ultra-polished local-first music player with real bundled WAV playback",
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.deluxetunes.desktop",
    "productName": "Deluxe Tunes",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/main.cjs",
      "electron/preload.cjs",
      "server.mjs",
      "server/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Deluxe-Tunes-Setup-v${version}.exe",
      "icon": "public/logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Deluxe Tunes",
      "installerIcon": "public/logo.ico",
      "uninstallerIcon": "public/logo.ico",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  },
  "allowScripts": {
    "electron@38.8.6": true
  }
}
